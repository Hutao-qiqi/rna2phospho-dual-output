{
  "architecture": "protein_anchored_axial_dynamic_pathway_heterogeneous_hypergraph",
  "locked_split": {
    "selection_train": 916,
    "selection_validation": 229,
    "sealed_test": 286
  },
  "model": {
    "max_pathways": 128,
    "hidden": 64,
    "heads": 4,
    "axial_layers": 2,
    "pathway_adapter_rank": 8,
    "sample_knn": 16,
    "max_rna_members": 128,
    "max_protein_members": 128,
    "max_site_pathways": 8,
    "max_site_kinases": 8,
    "site_chunk_size": 512,
    "initial_site_shrinkage": 0.1,
    "dropout": 0.1
  },
  "optimization": {
    "epochs": 80,
    "patience": 10,
    "batch_size": 128,
    "cache_batch_size": 64,
    "precision": "float32",
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "pearson_loss_weight": 0.2,
    "variance_loss_weight": 0.1,
    "shrinkage_regularization": 0.01
  },
  "target_contract": "training-fold within-study site standardization followed by sample-row median centering",
  "minimum_study_site_observations": 8,
  "reference_residual_memory": "training-only, self-excluded for training queries, masked and site-chunked",
  "checkpoint_metric": "validation_per_site_spearman_median",
  "sealed_test_evaluated_during_development": false
}
